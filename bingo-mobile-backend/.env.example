# Copy this file to .env and fill in your values (or set them in Coolify/your
# deploy platform). This stack runs the phone+password backend for the mobile
# app only — it uses its OWN Postgres database and does NOT run a Telegram bot.

# --- Postgres (separate DB from the Mini App stack) ---
POSTGRES_USER=bingo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bingo_mobile

# --- API / deployment ---
# Host port the backend is exposed on (8081 so it can coexist with the Mini App
# backend on 8080). Point bingo-mobile's EXPO_PUBLIC_BACKEND_URL at its public
# HTTPS tunnel (ngrok / domain) which forwards here.
BACKEND_PORT=8081

# --- Mobile-app auth (phone + password JWT) ---
# Secret must be >= 32 characters. Keep it stable between restarts or all
# existing tokens become invalid.
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_MINUTES=10080

# Bootstraps a SUPER_ADMIN account at startup, so no Telegram is required.
SUPER_ADMIN_PHONE=09XXXXXXXX
SUPER_ADMIN_PASSWORD=change-me-strong-password

# --- Telegram (leave empty here — the Mini App backend owns the bot) ---
# BOT_USERNAME=
# BOT_TOKEN=