# Copy this file to .env and fill in your values (or set them in Coolify).
# This is the FULL mobile stack (postgres + backend + web frontend), deployed
# exactly like the Mini App stack in frontAndBackend. It uses its OWN database
# and never runs a Telegram bot.

# --- Postgres (separate DB from the Mini App stack) ---
POSTGRES_USER=bingo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bingo_mobile

# --- Host ports (only used when not behind a Coolify proxy) ---
FRONTEND_PORT=3003
BACKEND_PORT=8081

# --- Mobile-app auth (phone + password JWT) ---
# Secret must be >= 32 characters. Keep it stable between restarts.
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_MINUTES=10080

# Bootstraps a SUPER_ADMIN account at startup, so no Telegram is required.
SUPER_ADMIN_PHONE=09XXXXXXXX
SUPER_ADMIN_PASSWORD=change-me-strong-password

# --- Frontend bundle ---
# Public HTTPS URL of the mobile backend, baked into the web bundle at build
# time. In Coolify, give the backend service its own domain and set this to it,
# e.g. https://api.mobile.example.com
EXPO_PUBLIC_BACKEND_URL=

# --- Telegram ---
# Optional. Without a token the bot stays off and the app works on phone +
# password alone. With one, invite links (t.me/<bot>?start=CODE) register admins
# and players, and the bot offers to set the password used for mobile login.
# BOT_TOKEN and BOT_USERNAME must belong to the SAME bot account.
BOT_TOKEN=
BOT_USERNAME=
# A second, registration-only bot. When set, invite links point here and the game
# bot is left for playing. Leave empty to use the game bot for registration too.
REGISTRATION_BOT_TOKEN=
REGISTRATION_BOT_USERNAME=
# Chat menu button opening the web app as a Telegram Mini App. Off by default;
# when off, a button already handed out is reset to Telegram's default.
BOT_WEBAPP_BUTTON_ENABLED=false
# Public HTTPS URL of the mobile web app, used by the /app command and by the
# Mini App button above.
MINI_APP_URL=https://your-mobile-webapp.example.com